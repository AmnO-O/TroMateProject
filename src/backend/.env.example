APP_ENV=local
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Public HTTPS base URL from the tunnel, no trailing slash.
PUBLIC_BASE_URL=https://replace-me.trycloudflare.com

# ptb | aiogram | telebot (aiogram is required for PA4 UC01 /new and UC05 flows)
BOT_LIBRARY=aiogram

TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=change-me-0123456789abcdef
TELEGRAM_WEBHOOK_PATH=/webhook/telegram
AUTO_SET_WEBHOOK=true

MINIAPP_INITDATA_MAX_AGE_SECONDS=3600
MINIAPP_INITDATA_MAX_LENGTH=8192
MINIAPP_MAX_BODY_BYTES=1048576

# --- Database (PostgreSQL on Neon) -------------------------------------------
# Paste the connection string from Neon Console -> Connect. Both forms work:
#   postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require
#   postgresql+asyncpg://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?ssl=require
# app/db/session.py switches to the asyncpg driver and translates sslmode/channel_binding.
# Prefer the direct endpoint (no "-pooler" in the host) for Alembic migrations.
DATABASE_URL=postgresql://tromate:password@localhost:5432/tromate
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Optional disposable PostgreSQL URL for running tests/db/ (never point at DATABASE_URL).
# TEST_DATABASE_URL=postgresql://tromate:password@localhost:5432/tromate_test

# --- Google Gemini (AI Extraction Adapter) -------------------------------------
# Leave empty to use the rule-based VND parser fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
