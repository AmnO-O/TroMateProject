APP_ENV=local
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Public HTTPS base URL from the tunnel, no trailing slash.
PUBLIC_BASE_URL=https://replace-me.trycloudflare.com

# ptb | aiogram | telebot (aiogram is required for PA4 UC01 /new and UC05 flows)
BOT_LIBRARY=aiogram

TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=change-me-0123456789abcdef
TELEGRAM_WEBHOOK_PATH=/webhook/telegram
AUTO_SET_WEBHOOK=true

MINIAPP_INITDATA_MAX_AGE_SECONDS=3600
MINIAPP_INITDATA_MAX_LENGTH=8192
MINIAPP_MAX_BODY_BYTES=1048576

# --- Database (PostgreSQL on Neon) -------------------------------------------
# Paste the connection string from Neon Console -> Connect. Both forms work:
#   postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require
#   postgresql+asyncpg://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?ssl=require
# app/db/session.py switches to the asyncpg driver and translates sslmode/channel_binding.
# Prefer the direct endpoint (no "-pooler" in the host) for Alembic migrations.
DATABASE_URL=postgresql://tromate:password@localhost:5432/tromate
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Optional disposable PostgreSQL URL for running tests/db/ (never point at DATABASE_URL).
# TEST_DATABASE_URL=postgresql://tromate:password@localhost:5432/tromate_test

# --- Google Gemini (AI Extraction Adapter) -------------------------------------
# Leave empty to use the rule-based VND parser fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Time durations (SCRUM-138, Use-Case Specification v3.0) -------------------
# All values are in minutes. Leave them unset for the production values shown here.
# With APP_ENV=production the app refuses to start if any of them differs.
# Test Plan v1.2 section 3 values for the shared test environment are in brackets.
# REVIEW_WINDOW_MIN_MINUTES=1440              # BR03 min auto-confirm window: 1 day   [5]
# REVIEW_WINDOW_MAX_MINUTES=43200             # BR03 max auto-confirm window: 30 days [43200]
# REP_VOTE_PERIOD_MINUTES=                    # BR10 unset = period the Rep chooses (12/24/48/72 h) [10]
# CHANGE_REQUEST_VOTE_PERIOD_MINUTES=1440     # BR11 vote opened by a change request: 24 h [10]
# VOTE_REMINDER_BEFORE_END_MINUTES=120        # BR10 reminder before a vote ends: 2 h [2]
# CHANGE_REQUEST_OPEN_PERIOD_MINUTES=4320     # BR11 change request open period: 3 days [10]
# PROPOSAL_COOLDOWN_MINUTES=10080             # BR11 cooldown between requests/votes: 7 days [15]
# DISPUTE_REMINDER_INTERVAL_MINUTES=4320      # BR04 Disputed expense reminder interval: 3 days [10]
# DEADLINE_REMINDER_BEFORE_MINUTES=1440       # BR03 reminder before auto-confirm deadline: 24 h [5]
# DEADLINE_REMINDER_MIN_WINDOW_MINUTES=1440   # BR03 only for windows longer than: 1 day [5]
